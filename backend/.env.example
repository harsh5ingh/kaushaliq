APP_NAME=KaushalIQ
APP_VERSION=0.1.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
AUTH_SESSION_TTL=8h
JWT_SECRET=
AUTH_DATABASE_PATH=data/auth.sqlite3
AUTH_COOKIE_SAMESITE=lax

# Verification: backend only. Empty credentials never enable mock delivery.
# Supported email: resend, brevo. Sender must be verified with the provider.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=KaushalIQ
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Optional phone verification: currently brevo transactional SMS (subject to local rules).
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
# Private files: not served statically. Default alongside auth database.
RESUME_STORAGE_PATH=data/private-resumes
RESUME_MAX_BYTES=5242880

# Optional server-only OAuth. Missing or invalid configuration disables the provider.
# Register these EXACT callback paths with each provider (matching API_URL origin):
# Local Google: http://localhost:8000/api/auth/oauth/google/callback
# Local GitHub: http://localhost:8000/api/auth/oauth/github/callback
# Production: https://<api-host>/api/auth/oauth/<provider>/callback
# Use the same localhost/127.0.0.1 hostname for frontend and backend in development.
# Restart the backend after changing local .env. Never put client secrets in VITE_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
# Optional absolute path to a validated snapshot + adjacent manifest.json.
# Default: project/data/canonical/labour-market.json. No download on API startup.
# CANONICAL_DATA_PATH=D:/SIH part 2/KaushalIQ/data/canonical/labour-market.json

# Manual local seed only. Never automatic startup; production always rejects demo identities.
DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo@kaushaliq.local
DEMO_ACCOUNT_PASSWORD=
# Optional demand snapshot override; adjacent manifest.json is required.
# Default: project/data/canonical/demand/snapshot.json. No runtime download/fallback.
# DEMAND_DATA_PATH=
# Optional training activity/infrastructure publication override; adjacent manifest required.
# SUPPLY_DATA_PATH=
