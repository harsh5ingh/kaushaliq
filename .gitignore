# -------------------------
*.pid
*.pid.lock

# SQLite / local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# -------------------------
# User-generated / private data
# -------------------------
uploads/
storage/
media/
user_uploads/
private_uploads/
resumes/
resume_uploads/

# -------------------------
# Generated application data
# -------------------------
generated/
generated-data/
runtime/
runtime-data/

