# -------------------------
# OS / Editor
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.swp
*.swo
*~

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.crt
*.p12
*.pfx

# -------------------------
# Logs
# -------------------------
*.log
logs/
log/

# -------------------------
# Temporary files
# -------------------------
tmp/
temp/
.cache/
.cache-loader/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# -------------------------
# Node / Frontend
# -------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
.yarn-integrity

# Build output
dist/
build/
coverage/

# Vite
.vite/

