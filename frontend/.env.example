# Public client configuration only. Empty uses the existing /api proxy.
VITE_API_BASE_URL=
# Public client settings only. OAuth/provider credentials and all auth secrets belong in backend/.env.

# Optional public social profiles (absolute HTTPS URLs). Empty/invalid values hide icons.
# Rebuild/restart Vite after changing these values.
VITE_GITHUB_URL=https://github.com/harsh5ingh/kaushaliq
VITE_LINKEDIN_URL=
VITE_X_URL=
VITE_YOUTUBE_URL=
